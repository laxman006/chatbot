# Environment Configuration for Production RAG System

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENV=development  # development, staging, production

# ============================================================================
# WEAVIATE CONFIGURATION
# ============================================================================
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=  # Optional, leave empty for anonymous access

# ============================================================================
# LLM PROVIDER - OPENAI
# ============================================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORG_ID=  # Optional

# LLM Model Configuration
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# ============================================================================
# EMBEDDINGS - OPENAI
# ============================================================================
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100

# ============================================================================
# CHUNKING CONFIGURATION
# ============================================================================
CHUNKING_STRATEGY=adaptive  # recursive, semantic, markdown_aware, adaptive
CHUNK_SIZE=800
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=1500

# Semantic Chunking (if using semantic strategy)
SEMANTIC_SIMILARITY_THRESHOLD=0.7

# ============================================================================
# RETRIEVAL CONFIGURATION
# ============================================================================
# Hybrid Search
HYBRID_SEARCH_ALPHA=0.7  # 0=BM25 only, 1=vector only, 0.7=balanced
TOP_K_RETRIEVAL=50
TOP_K_RERANK=10

# MMR Diversification
MMR_LAMBDA=0.7  # 0=max diversity, 1=max relevance

# Query Expansion
ENABLE_QUERY_EXPANSION=true
MAX_EXPANDED_QUERIES=3

# ============================================================================
# RERANKING CONFIGURATION
# ============================================================================
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
ENABLE_RERANKING=true
ENABLE_MMR=true
ENABLE_CONTEXT_COMPRESSION=true

# ============================================================================
# INTENT CLASSIFICATION
# ============================================================================
ENABLE_INTENT_CLASSIFICATION=true
INTENT_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# DEDUPLICATION
# ============================================================================
ENABLE_DEDUPLICATION=true
EXACT_DEDUP_ENABLED=true
NEAR_DEDUP_ENABLED=true
SEMANTIC_DEDUP_ENABLED=true
NEAR_DEDUP_THRESHOLD=0.85
SEMANTIC_DEDUP_THRESHOLD=0.95

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# LangSmith
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=rag-chatbot-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
ENABLE_LANGSMITH=true

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json or text

# Metrics
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090

# ============================================================================
# EVALUATION
# ============================================================================
ENABLE_CONTINUOUS_EVAL=true
EVAL_SAMPLE_RATE=0.1  # Evaluate 10% of queries
EVAL_METRICS=faithfulness,answer_relevancy,context_precision,context_recall

# ============================================================================
# CONTEXT WINDOW MANAGEMENT
# ============================================================================
MAX_CONTEXT_TOKENS=6000  # Leave room for response
MAX_HISTORY_MESSAGES=10
CONTEXT_PRIORITIZATION=recent_first  # recent_first or relevance_first

# ============================================================================
# CACHING
# ============================================================================
ENABLE_EMBEDDING_CACHE=true
ENABLE_QUERY_CACHE=true
CACHE_TTL=3600  # seconds

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# COLLECTION-SPECIFIC SETTINGS
# ============================================================================
# Collections to create
COLLECTIONS=Blogs,InternalDocs,Spreadsheets,Transcripts,JiraTickets,PDFs,GeneralKnowledge

# ============================================================================
# JIRA INTEGRATION (if using Jira loader)
# ============================================================================
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEYS=PROJ1,PROJ2

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# SECURITY
# ============================================================================
API_KEY_ENABLED=false
API_KEY=your-api-key-here
