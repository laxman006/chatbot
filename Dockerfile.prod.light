# ============================================
# LIGHTWEIGHT PRODUCTION DOCKERFILE
# ============================================
# Uses requirements.prod.light.txt (no sentence-transformers)
# Removes 5GB+ NVIDIA CUDA dependencies
# Build time: ~3-5 minutes
# Image size: ~2GB (vs 6GB+ with CUDA)
# ============================================

# Use Python 3.12 slim image
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Install ONLY essential system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy lightweight requirements
COPY requirements.prod.light.txt .

# Install Python dependencies (lightweight - no GPU packages)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --use-deprecated=legacy-resolver -r requirements.prod.light.txt

# Copy application code
COPY . .

# Create data directory
RUN mkdir -p /app/data

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash app && \
    chown -R app:app /app
USER app

# Expose port
EXPOSE 8002

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

# Start the application
CMD ["python", "server.py"]





